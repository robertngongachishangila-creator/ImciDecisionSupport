<?xml version="1.0" encoding="utf-8"?><!--
   Backup is disabled (android:allowBackup="false"); these rules additionally exclude
   all data on devices older than API 31, in case backup is ever re-enabled.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
